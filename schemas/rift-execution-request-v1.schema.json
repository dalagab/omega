{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalagab.github.io/omega/schemas/rift-execution-request-v1.schema.json",
  "title": "Omega broker/orchestrator request for one Rift runtime exercise",
  "type": "object",
  "required": ["schema", "requestId", "variantId", "artifactSha256", "artifactUrl", "profile", "authority"],
  "properties": {
    "schema": {"const": "omega.rift.execution-request.v1"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 160},
    "variantId": {"type": "integer", "minimum": 1},
    "artifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactUrl": {"type": "string", "pattern": "^https://"},
    "profile": {"type": "string", "minLength": 1},
    "authority": {"enum": ["orchestrator", "analysis-broker"]},
    "requestedAtUtc": {"type": "string"},
    "entryModel": {"enum": ["component", "location"]}
  },
  "additionalProperties": true
}
