{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.invalid/schemas/omega-alpha-test-v1.schema.json",
  "title": "Omega Alpha test manifest v1",
  "type": "object",
  "required": ["schema", "id", "title", "status", "project", "assemblyName", "entryAssembly", "mode", "safetyClass", "engines", "expected"],
  "properties": {
    "schema": {"const": "omega.alpha.test.v1"},
    "id": {"type": "string", "pattern": "^alpha\\.[a-z0-9][a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"enum": ["draft", "candidate", "active", "retired"]},
    "project": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.csproj$"},
    "assemblyName": {"type": "string", "minLength": 1},
    "entryAssembly": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.dll$"},
    "mode": {"enum": ["static-only", "sandbox-runtime"]},
    "safetyClass": {"enum": ["inert-static", "sandbox-local-runtime"]},
    "engines": {"type": "array", "items": {"enum": ["sigmascope", "rift", "srl"]}, "minItems": 1, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected": {"type": "object"}
  },
  "additionalProperties": false
}
