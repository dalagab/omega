    "website": {
      "description": "A cooldown reminder for FFXIV. It stays empty until you use something — then, once it's back up, its icon appears. Press it, and it's gone again.",
      "homepage": "",
      "images": [
        "https://raw.githubusercontent.com/juan-medina/ItsUp/main/docs/move-mode.png",
        "https://raw.githubusercontent.com/juan-medina/ItsUp/main/docs/warming-icon.gif",
        "https://raw.githubusercontent.com/juan-medina/ItsUp/main/docs/config-1.jpg",
        "https://raw.githubusercontent.com/juan-medina/ItsUp/main/docs/config-2.jpg",
        "https://raw.githubusercontent.com/juan-medina/ItsUp/main/docs/config-3.jpg"
      ],
      "links": [
