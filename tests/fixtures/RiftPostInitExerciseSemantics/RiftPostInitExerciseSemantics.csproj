<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <AssemblyName>RiftPostInitExerciseSemantics</AssemblyName>
    <RootNamespace>RiftPostInitExerciseSemantics</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <Import Project="../../../build/Rift.Dalamud.Contract.props" />
  <Target Name="RequireRiftFfxivClientStructsContract" BeforeTargets="ResolveReferences">
    <Error Condition="'$(HooksDir)' != '' and !Exists('$(HooksDir)/FFXIVClientStructs.dll')" Text="Rift post-init fixture cannot find $(HooksDir)/FFXIVClientStructs.dll." />
  </Target>
  <ItemGroup Condition="'$(HooksDir)' != ''">
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(HooksDir)/FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
