    "projectRepository": "https://github.com/SomethingAstraSomething/PinkChocoboTrivial",
    "schema": "omega.evidence.presentation.v1",
    "website": {
      "description": "A trivial made for a Pinkish Venue! ; it has many questions of ARR, Heavensward, Endwalker, etc... It is thought to be ran by the host of the events",
      "homepage": "",
      "images": [],
      "links": [
        {
          "kind": "source",
