    "projectRepository": "https://github.com/paissaheavyindustries/WheresMouse",
    "schema": "omega.evidence.presentation.v1",
    "website": {
      "description": "This Dalamud plugin is an accessibility plugin to help you locate your mouse cursor when you need it the most.",
      "homepage": "",
      "images": [
        "https://i.imgur.com/xOWZa3s.jpg"
      ],
      "links": [
        {
          "kind": "source",
          "label": "Source",
          "url": "https://github.com/paissaheavyindustries/WheresMouse"
        }
