    "plugin": {
      "description": "Use /achex to track achievements, open native Achievement entries, and passively cache observed progress. This Ex mainline build is non-automated; Ex+ is reserved for the experimental automation branch.\nhttps://raw.githubusercontent.com/vauxra/achieve-ex/refs/heads/main/pluginmaster.json",
      "images": [
        "https://raw.githubusercontent.com/vauxra/achieve-ex/main/AchievementTracker/images/icon.png"
      ],
