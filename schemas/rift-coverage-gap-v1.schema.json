{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalagab.github.io/omega/schemas/rift-coverage-gap-v1.schema.json",
  "title": "Interdimensional Rift engineering coverage-gap report",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "plugin",
    "runtime_gaps",
    "blockers",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": "rift.coverage-gap.v1"
    },
    "producer": {
      "const": "rift-coverage-gap-summarizer"
    },
    "plugin": {
      "type": "object"
    },
    "runtime_gaps": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "coverage_categories_touched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation": {
      "type": "object"
    },
    "observed_hook_operations": {
      "type": "array"
    },
    "observed_signature_operations": {
      "type": "array"
    },
    "emulation_limits": {
      "type": "array"
    },
    "observed_registrations": {
      "type": "array"
    },
    "observed_exercise_operations": {
      "type": "array"
    },
    "exercise": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
