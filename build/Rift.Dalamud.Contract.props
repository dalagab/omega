<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <HooksDir Condition="'$(HooksDir)' == '' and '$(RIFT_HOOKS)' != ''">$(RIFT_HOOKS)</HooksDir>
  </PropertyGroup>

  <Target Name="RequireRiftDalamudContract" BeforeTargets="ResolveReferences">
    <Error Condition="'$(HooksDir)' == ''" Text="Rift fixture build requires HooksDir (or RIFT_HOOKS) pointing at a frozen Dalamud runtime." />
    <Error Condition="'$(HooksDir)' != '' and !Exists('$(HooksDir)/Dalamud.dll')" Text="Rift fixture build cannot find $(HooksDir)/Dalamud.dll." />
  </Target>

  <ItemGroup Condition="'$(HooksDir)' != ''">
    <Reference Include="Dalamud">
      <HintPath>$(HooksDir)/Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
