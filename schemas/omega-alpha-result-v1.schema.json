{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.invalid/schemas/omega-alpha-result-v1.schema.json",
  "title": "Omega Alpha calibration result v1",
  "type": "object",
  "required": ["schema", "lane", "synthetic", "authority", "testId", "registryRevision", "findings", "calibration"],
  "properties": {
    "schema": {"const": "omega.alpha.scan-result.v1"},
    "lane": {"const": "alpha"},
    "synthetic": {"const": true},
    "authority": {"const": "calibration-only"},
    "testId": {"type": "string", "pattern": "^alpha\\."},
    "registryRevision": {"type": "string", "pattern": "^alpha-registry-v1-[0-9a-f]{20}$"},
    "findings": {"type": "array"},
    "calibration": {"type": "object"}
  }
}
