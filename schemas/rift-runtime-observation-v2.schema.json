{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalagab.github.io/omega/schemas/rift-runtime-observation-v2.schema.json",
  "title": "Interdimensional Rift runtime observation report",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "producer_version",
    "ran_at",
    "execution",
    "plugin",
    "exercise",
    "observations",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "rift.runtime-observation.v2"
    },
    "producer": {
      "type": "string"
    },
    "producer_version": {
      "type": "string"
    },
    "ran_at": {
      "type": "string"
    },
    "execution": {
      "type": "object"
    },
    "plugin": {
      "type": "object",
      "required": [
        "path",
        "load_outcome"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "load_outcome": {
          "type": "string"
        }
      }
    },
    "exercise": {
      "type": "object",
      "required": [
        "schema_version",
        "profile",
        "status",
        "framework_ticks_requested",
        "registrations_discovered",
        "registrations_exercised",
        "registrations_unexercised",
        "by_kind",
        "registrations"
      ],
      "properties": {
        "schema_version": {
          "const": "rift.exercise.v1"
        },
        "profile": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "component",
              "operation",
              "status",
              "planned_invocations",
              "invocations"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "component": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "planned_invocations": {
                "type": "integer",
                "minimum": 0
              },
              "invocations": {
                "type": "integer",
                "minimum": 0
              },
              "due_tick": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "framework_ticks_requested": {
          "type": "integer",
          "minimum": 0
        },
        "registrations_discovered": {
          "type": "integer",
          "minimum": 0
        },
        "registrations_exercised": {
          "type": "integer",
          "minimum": 0
        },
        "registrations_unexercised": {
          "type": "integer",
          "minimum": 0
        },
        "by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "ts_offset_ms",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "ts_offset_ms": {
            "type": "integer",
            "minimum": 0
          },
          "phase": {
            "type": "string"
          },
          "activity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_activity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "registration_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "invocation": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_observations",
        "by_kind"
      ]
    }
  },
  "additionalProperties": true
}
