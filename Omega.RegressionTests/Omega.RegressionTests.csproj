<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Omega.RegressionTests</AssemblyName>
    <RootNamespace>Dalagab.Omega.RegressionTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="RegressionCases.Catalog.cs" />
    <Compile Include="RegressionCases.CollectionsAndSpotlight.cs" />
    <Compile Include="RegressionCases.Core.cs" />
    <Compile Include="RegressionCases.EulaAndDistribution.cs" />
    <Compile Include="RegressionCases.Helpers.cs" />
    <Compile Include="RegressionCases.InstallAndDistribution.cs" />
    <Compile Include="RegressionCases.OnlineAndUi.cs" />
    <Compile Include="RegressionCases.PluginNavigationLifecycle.cs" />
    <Compile Include="RegressionCases.SecurityIntelligence.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.8" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omega\DalagabOmega.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\Omega\Models\MarketplacePlugin.cs" Link="Product\MarketplacePlugin.cs" />
    <Compile Include="..\Omega\Models\MarketplaceSecurityFinding.cs" Link="Product\MarketplaceSecurityFinding.cs" />
    <Compile Include="..\Omega\Models\RepositorySource.cs" Link="Product\RepositorySource.cs" />
    <Compile Include="..\Omega\Models\CuratedSourceDefinition.cs" Link="Product\CuratedSourceDefinition.cs" />
    <Compile Include="..\Omega\Services\RepositoryManifestParser.cs" Link="Product\RepositoryManifestParser.cs" />
    <Compile Include="..\Omega\Services\MarketplaceCatalogRules.cs" Link="Product\MarketplaceCatalogRules.cs" />
    <Compile Include="..\Omega\Services\MarketplacePresentationRules.cs" Link="Product\MarketplacePresentationRules.cs" />
    <Compile Include="..\Omega\Services\RepositoryCatalogStatus.cs" Link="Product\RepositoryCatalogStatus.cs" />
    <Compile Include="..\Omega\Services\RepositoryHealthRules.cs" Link="Product\RepositoryHealthRules.cs" />
    <Compile Include="..\Omega\Services\SqliteCatalogStore.cs" Link="Product\SqliteCatalogStore.cs" />
    <Compile Include="..\Omega\BuildInfo.cs" Link="Product\BuildInfo.cs" />
    <Compile Include="..\Omega\Services\OnlineCatalogClient.cs" Link="Product\OnlineCatalogClient.cs" />
    <Compile Include="..\Omega\Services\StorefrontVirtualization.cs" Link="Product\StorefrontVirtualization.cs" />
    <Compile Include="..\Omega\Services\MarketplaceTagRules.cs" Link="Product\MarketplaceTagRules.cs" />
  </ItemGroup>

  <Target Name="RunOmegaRegressionTests" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Running Omega regression suite..." />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(MSBuildProjectDirectory)\..&quot;" />
  </Target>
</Project>
