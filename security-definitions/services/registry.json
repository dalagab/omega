{
  "schema": "omega.service-registry.v1",
  "version": 1,
  "services": [
    {
      "id": "platform.github",
      "name": "GitHub",
      "hosts": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com"
      ],
      "categories": [
        "source-hosting"
      ],
      "capabilities": [
        "source.repository",
        "source.content",
        "source.distribution"
      ],
      "purpose": "source hosting",
      "recognition": "established"
    },
    {
      "id": "platform.discord",
      "name": "Discord",
      "hosts": [
        "discord.com",
        "discordapp.com",
        "cdn.discordapp.com"
      ],
      "categories": [
        "community",
        "messaging"
      ],
      "capabilities": [
        "community.messaging",
        "community.media"
      ],
      "purpose": "community messaging",
      "recognition": "established"
    },
    {
      "id": "ffxiv.xivlauncher",
      "name": "XIVLauncher",
      "hosts": [
        "xivlauncher.net"
      ],
      "categories": [
        "ffxiv-infrastructure"
      ],
      "capabilities": [
        "ffxiv.launcher-infrastructure"
      ],
      "purpose": "FFXIV launcher infrastructure",
      "recognition": "established"
    },
    {
      "id": "ffxiv.dalamud",
      "name": "Dalamud",
      "hosts": [
        "dalamud.dev",
        "goatcorp.github.io",
        "kamori.goats.dev"
      ],
      "categories": [
        "ffxiv-infrastructure"
      ],
      "capabilities": [
        "ffxiv.plugin-infrastructure",
        "ffxiv.plugin-distribution"
      ],
      "purpose": "FFXIV plugin infrastructure",
      "recognition": "established"
    },
    {
      "id": "ffxiv.universalis",
      "name": "Universalis",
      "hosts": [
        "universalis.app"
      ],
      "categories": [
        "game-data",
        "market-data"
      ],
      "capabilities": [
        "ffxiv.market-data",
        "ffxiv.market-listings",
        "ffxiv.market-history"
      ],
      "purpose": "FFXIV market data",
      "recognition": "established"
    },
    {
      "id": "ffxiv.xivapi",
      "name": "XIVAPI",
      "hosts": [
        "xivapi.com"
      ],
      "categories": [
        "game-data"
      ],
      "capabilities": [
        "ffxiv.game-data"
      ],
      "purpose": "FFXIV game data",
      "recognition": "established"
    },
    {
      "id": "platform.nuget",
      "name": "NuGet",
      "hosts": [
        "nuget.org",
        "api.nuget.org"
      ],
      "categories": [
        "package-registry"
      ],
      "capabilities": [
        "package.metadata",
        "package.download"
      ],
      "purpose": "package registry",
      "recognition": "established"
    }
  ]
}
