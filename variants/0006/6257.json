    "schema": "omega.evidence.presentation.v1",
    "website": {
      "description": "A plugin for FFXIVQuickLauncher to help with manipulating housing items.",
      "homepage": "",
      "images": [],
      "links": [
        {
          "kind": "source",
          "label": "Source",
          "url": "https://github.com/LeonBlade/BDTHPlugin"
