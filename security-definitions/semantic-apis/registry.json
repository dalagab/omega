    {
      "id": "compiled.game.marketboard.purchase",
      "operation": "game.marketboard.purchase",
      "typeContains": [
        "MarketBoard",
        "ItemSearch"
      ],
      "members": [
        "Purchase",
        "Buy",
        "BuyItem",
        "ConfirmPurchase"
      ]
    },
    {
      "id": "compiled.game.marketboard.interact",
      "operation": "game.marketboard.interact",
      "typeContains": [
        "MarketBoard",
        "ItemSearch"
      ],
      "members": [
        "Interact",
        "Open",
        "OpenMarketBoard",
        "OpenItemSearch"
      ]
