{
  "schema": "ziprunner.quality/v1",
  "standard_version": "2026.07",
  "project": "omega",
  "source_file": {
    "target_lines": 400,
    "hard_limit_lines": 500,
    "existing_debt_mode": "ratchet"
  },
  "function": {
    "target_lines": 40,
    "hard_limit_lines": 80,
    "python_ast_audit": true
  },
  "tests": {
    "bugfix_requires_regression_test": true,
    "new_behavior_requires_tests": true,
    "focused_tests_first": true,
    "full_suite_before_package": true,
    "package_integrity_required": true
  },
  "design": {
    "architecture_changes_require_design_update": true,
    "material_decisions_require_adr": true,
    "public_contract_changes_require_schema_update": true,
    "automatic_work_requires_authored_design": true,
    "automatic_work_requires_section_references": true,
    "missing_decision_blocks_affected_scope_only": true,
    "design_fingerprint_must_match": true
  },
  "dependencies": {
    "prefer_standard_library": true,
    "new_dependency_requires_reason": true
  },
  "design_bounded_automation": {
    "enabled_by_default": false,
    "auto_accept_covered_design": true,
    "auto_admit_to_todo": true,
    "auto_start_managed_run": true,
    "stop_at_review": true,
    "max_cards_per_run": 3
  },
  "improvement": {
    "enabled": true,
    "rolling_open_items": 3,
    "global_rolling_suggestions": 3,
    "max_suggestions_per_project": 1,
    "target_reduction_per_pass": 250,
    "automatic_review_on_evidence": true
  },
  "source_extensions": [
    ".c",
    ".cc",
    ".cpp",
    ".cs",
    ".cxx",
    ".gd",
    ".go",
    ".h",
    ".hpp",
    ".java",
    ".js",
    ".jsx",
    ".kt",
    ".kts",
    ".lua",
    ".php",
    ".ps1",
    ".psm1",
    ".py",
    ".pyw",
    ".rb",
    ".rs",
    ".sh",
    ".sql",
    ".swift",
    ".ts",
    ".tsx"
  ],
  "exclude": [
    ".git/**",
    ".venv/**",
    "venv/**",
    "node_modules/**",
    "target/**",
    "build/**",
    "dist/**",
    "out/**",
    ".next/**",
    "coverage/**",
    "logs/**",
    "state/**",
    "runtime/**",
    "packages/**",
    "chrome-profile/**",
    "__pycache__/**",
    "vendor/**",
    "third_party/**",
    "generated/**",
    "**/*.min.js",
    "**/*.min.css"
  ]
}
