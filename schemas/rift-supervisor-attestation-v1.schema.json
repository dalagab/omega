{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalagab.github.io/omega/schemas/rift-supervisor-attestation-v1.schema.json",
  "title": "Interdimensional Rift trusted supervisor managed-report attestation",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "outcome",
    "runtime_report_sha256",
    "artifact_tree_sha256",
    "artifact_tree_hash_algorithm",
    "entry_sha256",
    "exercise_profile",
    "framework_ticks",
    "network",
    "seccomp",
    "boundary_profile",
    "contract_mode",
    "wall_timeout_seconds",
    "tmpfs",
    "dalamud_contract",
    "cgroup",
    "process_exit_code"
  ],
  "properties": {
    "schema_version": {"const": "rift.supervisor-attestation.v1"},
    "producer": {"const": "interdimensional-rift-supervisor"},
    "outcome": {"const": "runtime_report_emitted"},
    "runtime_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_tree_hash_algorithm": {"type": "string", "minLength": 1},
    "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exercise_profile": {"enum": ["post-init-safe-v1", "none"]},
    "framework_ticks": {"type": "integer", "minimum": 0, "maximum": 32},
    "network": {"const": "isolated"},
    "seccomp": {"const": "enforced"},
    "boundary_profile": {"type": "string", "minLength": 1},
    "contract_mode": {"type": "string", "minLength": 1},
    "wall_timeout_seconds": {"type": "integer", "minimum": 1},
    "tmpfs": {
      "type": "object",
      "required": ["tmp_bytes", "home_bytes", "work_bytes"],
      "properties": {
        "tmp_bytes": {"type": "integer", "minimum": 1},
        "home_bytes": {"type": "integer", "minimum": 1},
        "work_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "dalamud_contract": {
      "type": "object",
      "required": ["track", "dalamud_sha256", "tree_sha256", "hash_algorithm"],
      "properties": {
        "track": {"enum": ["release", "stg", "unknown"]},
        "dalamud_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_algorithm": {"type": "string", "minLength": 1}
      }
    },
    "cgroup": {
      "type": "object",
      "required": ["memory_max", "memory_swap_max", "tasks_max", "cpu_quota", "memory_oom_kill_delta", "pids_max_delta"],
      "properties": {
        "memory_max": {"type": "string", "minLength": 1},
        "memory_swap_max": {"const": "0"},
        "tasks_max": {"type": "integer", "minimum": 1},
        "cpu_quota": {"type": "string", "minLength": 1},
        "memory_oom_kill_delta": {"type": "integer", "minimum": 0},
        "pids_max_delta": {"type": "integer", "minimum": 0}
      }
    },
    "process_exit_code": {"type": "integer"}
  },
  "additionalProperties": true
}
