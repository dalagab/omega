{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.invalid/schemas/omega-alpha-registry-v1.schema.json",
  "title": "Omega Alpha offensive-security registry v1",
  "type": "object",
  "required": ["schema", "branch", "entries"],
  "properties": {
    "schema": {"const": "omega.alpha.registry.v1"},
    "branch": {"const": "alpha"},
    "description": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "manifestPath", "projectPath", "assemblyName", "entryAssembly", "mode", "safetyClass", "engines", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^alpha\\.[a-z0-9][a-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "status": {"enum": ["draft", "candidate", "active", "retired"]},
          "manifestPath": {"type": "string", "pattern": "^tests/.+/alpha\\.json$"},
          "projectPath": {"type": "string", "pattern": "^tests/"},
          "assemblyName": {"type": "string", "minLength": 1},
          "entryAssembly": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.dll$"},
          "mode": {"enum": ["static-only", "sandbox-runtime"]},
          "safetyClass": {"enum": ["inert-static", "sandbox-local-runtime"]},
          "engines": {"type": "array", "items": {"enum": ["sigmascope", "rift", "srl"]}, "minItems": 1, "uniqueItems": true},
          "tags": {"type": "array", "items": {"type": "string"}},
          "expected": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
