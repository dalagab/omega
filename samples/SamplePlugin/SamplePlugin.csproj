<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SamplePlugin</AssemblyName>
    <RootNamespace>SamplePlugin</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Target the vendored interface surface, NOT the real Dalamud.dll.
      The shim publishes as "Dalamud" so a plugin author who writes
      `using Dalamud.Plugin;` ends up with the rift's stubs in their
      compiled code without ever touching our project name.
    -->
    <ProjectReference Include="..\..\InterdimensionalRift.DalamudShim\InterdimensionalRift.DalamudShim.csproj" />
  </ItemGroup>
</Project>
