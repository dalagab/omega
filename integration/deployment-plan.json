    "requestSchema": "omega.rift.alpha-execution-request.v1",
    "resultSchema": "omega.rift.alpha-run.v1",
    "localAuthority": "local-alpha"
  },
  "defensiveComparison": {
    "engines": [
      "sigmascope",
      "srl",
      "stigma-1"
    ],
    "alphaSelfReportAuthority": "offensive-claim-only",
    "independentFindingsRequired": true
  }
