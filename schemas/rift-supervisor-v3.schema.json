{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalagab.github.io/omega/schemas/rift-supervisor-v3.schema.json",
  "title": "Interdimensional Rift outer supervisor report",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "artifact_sha256",
    "entry_sha256",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "rift.supervisor.v3"
    },
    "producer": {
      "const": "interdimensional-rift-supervisor"
    },
    "artifact_sha256": {
      "type": "string"
    },
    "entry_sha256": {
      "type": "string"
    },
    "execution": {
      "type": "object",
      "required": [
        "outcome",
        "network",
        "seccomp",
        "cgroup"
      ]
    },
    "artifact_hash_algorithm": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
