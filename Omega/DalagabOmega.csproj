<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.9.20</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <AssemblyName>DalagabOmega</AssemblyName>
    <RootNamespace>Dalagab.Omega</RootNamespace>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\images\icon.png">
      <Link>icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\images\company-fallback.png">
      <Link>company-fallback.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\images\title-icon.png">
      <Link>title-icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\images\sigmascope-banner.png">
      <Link>sigmascope-banner.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\EULA.md">
      <Link>EULA.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\sources\curated-sources.json">
      <Link>curated-sources.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\catalog\catalog-endpoint.json">
      <Link>catalog-endpoint.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\catalog\bootstrap\omega-catalog.sqlite.zip" Condition="Exists('..\catalog\bootstrap\omega-catalog.sqlite.zip')">
      <Link>omega-catalog.sqlite.zip</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <Target Name="CopyOmegaSqliteNativeToPluginDirectory" AfterTargets="Build">
    <PropertyGroup>
      <OmegaSqliteNativePath>$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll</OmegaSqliteNativePath>
    </PropertyGroup>
    <Error Condition="!Exists('$(OmegaSqliteNativePath)')" Text="Omega SQLite native runtime was not restored: $(OmegaSqliteNativePath)" />
    <Copy SourceFiles="$(OmegaSqliteNativePath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
