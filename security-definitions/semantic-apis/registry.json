{
  "schema": "omega.semantic-api-registry.v1",
  "version": 1,
  "sourceMatchers": [
    {
      "id": "dotnet.http.get",
      "operation": "network.http.request",
      "receiverContains": [
        "http",
        "client",
        "web"
      ],
      "members": [
        "GetAsync",
        "GetStringAsync",
        "GetByteArrayAsync",
        "SendAsync",
        "DownloadString",
        "DownloadData"
      ],
      "attributes": {
        "direction": "read"
      }
    },
    {
      "id": "data.collection.select",
      "operation": "data.select",
      "receiverContains": [],
      "members": [
        "First",
        "FirstOrDefault",
        "Single",
        "SingleOrDefault",
        "MinBy",
        "MaxBy",
        "OrderBy",
        "OrderByDescending"
      ],
      "attributes": {
        "dataFlow": true
      }
    },
    {
      "id": "game.navigation.move",
      "operation": "game.character.move",
      "receiverContains": [
        "navmesh",
        "vnav",
        "movement",
        "navigation"
      ],
      "members": [
        "Move",
        "MoveTo",
        "Pathfind",
        "PathfindAndMoveTo",
        "SetMovement"
      ],
      "attributes": {
        "targetAware": true
      }
    },
    {
      "id": "game.marketboard.interact",
      "operation": "game.marketboard.interact",
      "receiverContains": [
        "marketboard",
        "itemsearch"
      ],
      "members": [
        "Interact",
        "Open",
        "OpenMarketBoard",
        "OpenItemSearch"
      ],
      "attributes": {
        "semanticTarget": "marketboard"
      }
    },
    {
      "id": "game.marketboard.purchase",
      "operation": "game.marketboard.purchase",
      "receiverContains": [
        "marketboard",
        "itemsearch",
        "listing"
      ],
      "members": [
        "Purchase",
        "Buy",
        "BuyItem",
        "ConfirmPurchase"
      ],
      "attributes": {
        "semanticTarget": "marketboard"
      }
    },
    {
      "id": "game.marketboard.sell",
      "operation": "game.marketboard.sell",
      "receiverContains": [
        "marketboard",
        "retainer",
        "listing"
      ],
      "members": [
        "Sell",
        "List",
        "ListItem",
        "SetPrice"
      ],
      "attributes": {
        "semanticTarget": "marketboard"
      }
    },
    {
      "id": "game.world.interact",
      "operation": "game.character.interact",
      "receiverContains": [
        "targetsystem",
        "object",
        "npc"
      ],
      "members": [
        "Interact",
        "InteractWithObject",
        "ExecuteInteraction"
      ],
      "attributes": {
        "targetAware": true
      }
    },
    {
      "id": "time.delay",
      "operation": "time.delay",
      "receiverContains": [
        "task"
      ],
      "members": [
        "Delay"
      ],
      "attributes": {
        "temporal": true
      }
    }
  ],
  "compiledMatchers": [
    {
      "id": "compiled.game.navigation.move",
      "operation": "game.character.move",
      "typeContains": [
        "Navmesh",
