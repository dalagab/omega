{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.invalid/schemas/omega-rift-alpha-run-v1.schema.json",
  "title": "Rift Alpha local run evidence v1",
  "type": "object",
  "required": ["schema", "lane", "synthetic", "authority", "published", "runId", "alphaId", "backend", "scenarioSha256", "requestSha256", "outcome", "rift", "defensive"],
  "properties": {
    "schema": {"const": "omega.rift.alpha-run.v1"},
    "lane": {"const": "alpha"},
    "synthetic": {"const": true},
    "authority": {"const": "local-alpha"},
    "published": {"const": false},
    "runId": {"type": "string"},
    "alphaId": {"type": "string", "pattern": "^alpha\\."},
    "backend": {"enum": ["wsl2-bwrap", "linux-bwrap"]},
    "scenarioSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["completed", "failed"]},
    "offensive": {"type": ["object", "null"]},
    "rift": {"type": "object"},
    "defensive": {"type": "object"}
  }
}
