{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omega.actions.telemetry.v1",
  "title": "Omega Actions operational telemetry event",
  "type": "object",
  "required": [
    "schema",
    "event"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "omega.actions.telemetry.v1"
    },
    "event": {
      "enum": [
        "analysis.completed",
        "analysis.requested",
        "bundle.accepted",
        "bundle.created",
        "bundle.rejected",
        "plugin.selected",
        "publication.completed",
        "publication.progress",
        "publication.started",
        "queue.claimed",
        "queue.loaded",
        "queue.progress",
        "scan.completed",
        "scan.progress",
        "scan.started",
        "source.completed",
        "source.started",
        "worker.idle",
        "worker.started",
        "worker.stopped",
        "workflow.completed",
        "workflow.progress",
        "workflow.started"
      ]
    },
    "emittedAtUtc": {
      "type": "string",
      "maxLength": 64
    },
    "component": {
      "type": "string",
      "maxLength": 512
    },
    "stage": {
      "type": "string",
      "maxLength": 512
    },
    "state": {
      "type": "string",
      "maxLength": 512
    },
    "message": {
      "type": "string",
      "maxLength": 768
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleId": {
          "type": "string",
          "maxLength": 512
        },
        "label": {
          "type": "string",
          "maxLength": 512
        },
        "workerId": {
          "type": "string",
          "maxLength": 512
        },
        "state": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pluginId": {
          "type": "integer",
          "minimum": 0
        },
        "variantId": {
          "type": "integer",
          "minimum": 0
        },
        "internalName": {
          "type": "string",
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "maxLength": 512
        },
        "workType": {
          "type": "string",
          "maxLength": 512
        },
        "sourceName": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 512
        },
        "lane": {
          "type": "string",
          "maxLength": 512
        },
        "workType": {
          "type": "string",
          "maxLength": 512
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "maxLength": 512
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "maxLength": 512
        },
        "findingCount": {
          "type": "integer",
          "minimum": 0
        },
        "analysisCount": {
          "type": "integer",
          "minimum": 0
        },
        "artifactCount": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "errorCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "maxLength": 512
        },
        "evidenceRevision": {
          "type": "string",
          "maxLength": 512
        },
        "dependencyGraphRevision": {
          "type": "string",
          "maxLength": 512
        },
        "acceptedBundles": {
          "type": "integer",
          "minimum": 0
        },
        "rejectedBundles": {
          "type": "integer",
          "minimum": 0
        },
        "remainingBundles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
