    "schema": "omega.evidence.presentation.v1",
    "website": {
      "description": "BossMod FFXIV dalamud plugin, but with modules",
      "homepage": "",
      "images": [
        "https://raw.githubusercontent.com/FFXIV-CombatReborn/RebornAssets/main/IconAssets/BMR_Icon.png"
      ],
      "links": [
        {
          "kind": "source",
