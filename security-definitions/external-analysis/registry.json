{
  "schema": "omega.sigmascope.external-analysis-sources.v1",
  "version": 1,
  "semantics": "research-input-only",
  "sources": [
    {
      "id": "dotnet-roslyn",
      "name": ".NET Roslyn compiler and analyzer infrastructure",
      "repository": "https://github.com/dotnet/roslyn",
      "defaultRef": "main",
      "focusPaths": [
        "src/Analyzers/",
        "src/RoslynAnalyzers/",
        "docs/analyzers/"
      ],
      "languages": ["csharp", "visual-basic"],
      "analysisKinds": [
        "control-flow",
        "data-flow",
        "diagnostic-analyzer-design",
        "operation-tree",
        "semantic-model",
        "symbol-resolution"
      ],
      "license": {
        "name": "MIT License",
        "spdx": "MIT",
        "classification": "permissive",
        "source": "https://github.com/dotnet/roslyn"
      },
      "usage": {
        "automatedInspection": true,
        "aiIngestion": true,
        "copyImplementation": "permitted-with-attribution",
        "runtimeImport": false,
        "derivationMode": "architecture-reference",
        "notes": "Prefer native SigmaScope implementations even when direct reuse is license-compatible; Roslyn is primarily valuable for semantic-analysis architecture and APIs."
      }
    },
    {
      "id": "github-codeql-csharp",
      "name": "GitHub CodeQL C# queries and libraries",
      "repository": "https://github.com/github/codeql",
      "defaultRef": "main",
      "focusPaths": ["csharp/"],
      "languages": ["csharp"],
      "analysisKinds": [
        "api-modeling",
        "control-flow",
        "data-flow",
        "security-query-design",
        "taint-tracking"
      ],
      "license": {
        "name": "MIT License",
        "spdx": "MIT",
        "classification": "permissive",
        "source": "https://github.com/github/codeql/blob/main/LICENSE"
      },
      "usage": {
        "automatedInspection": true,
        "aiIngestion": true,
        "copyImplementation": "permitted-with-attribution",
        "runtimeImport": false,
        "derivationMode": "independent-reimplementation",
        "notes": "Use query concepts, source/sink modeling and test patterns to identify SigmaScope coverage gaps; keep SigmaScope observations and SRL semantics native."
      }
    },
    {
      "id": "security-code-scan",
      "name": "Security Code Scan Roslyn analyzers",
      "repository": "https://github.com/security-code-scan/security-code-scan",
      "defaultRef": "vs2019",
      "focusPaths": ["SecurityCodeScan.Vsix/", "SecurityCodeScan.Test/", "Roslyn/"],
      "languages": ["csharp", "visual-basic"],
      "analysisKinds": [
        "injection",
        "path-traversal",
        "roslyn-security-analyzers",
        "taint-tracking",
        "weak-cryptography"
      ],
      "license": {
        "name": "GNU Lesser General Public License v3.0",
        "spdx": "LGPL-3.0-only",
        "classification": "weak-copyleft",
        "source": "https://github.com/security-code-scan/security-code-scan/blob/vs2019/LICENSE"
      },
      "usage": {
        "automatedInspection": true,
        "aiIngestion": true,
        "copyImplementation": "review-required",
        "runtimeImport": false,
        "derivationMode": "independent-reimplementation",
        "notes": "Suitable for detector-concept research. Direct code reuse requires an explicit copyleft/license review before inclusion."
      }
    },
    {
      "id": "semgrep-engine",
      "name": "Semgrep Community Edition engine",
      "repository": "https://github.com/semgrep/semgrep",
      "defaultRef": "develop",
      "focusPaths": [],
      "languages": ["multi-language"],
      "analysisKinds": [
        "pattern-engine",
        "rule-engine-architecture",
        "taint-tracking"
      ],
      "license": {
        "name": "GNU Lesser General Public License v2.1",
        "spdx": "LGPL-2.1-only",
        "classification": "weak-copyleft",
        "source": "https://github.com/semgrep/semgrep/blob/develop/LICENSE"
      },
      "usage": {
        "automatedInspection": true,
        "aiIngestion": true,
        "copyImplementation": "review-required",
        "runtimeImport": false,
        "derivationMode": "architecture-reference",
        "notes": "Track engine architecture separately from Semgrep-maintained rule content, which has a different and more restrictive license."
      }
    },
    {
      "id": "semgrep-community-rules",
      "name": "Semgrep Community Edition rules",
      "repository": "https://github.com/semgrep/semgrep-rules",
      "defaultRef": "develop",
      "focusPaths": [],
      "languages": ["multi-language"],
      "analysisKinds": ["rule-catalog-metadata"],
      "license": {
        "name": "Semgrep Rules License v1.0",
        "spdx": "LicenseRef-Semgrep-Rules-1.0",
        "classification": "restricted-rules",
        "source": "https://semgrep.dev/legal/rules-license/"
      },
      "usage": {
        "automatedInspection": false,
        "aiIngestion": false,
        "copyImplementation": "blocked",
        "runtimeImport": false,
        "derivationMode": "metadata-only",
        "notes": "Track existence and licensing only. Do not ingest, redistribute, import, or derive product rules from current Semgrep-maintained rules without a separate license decision."
      }
    },
    {
      "id": "sonarsource-sonar-dotnet",
      "name": "SonarSource .NET analyzer",
      "repository": "https://github.com/SonarSource/sonar-dotnet",
      "defaultRef": "master",
      "focusPaths": ["analyzers/"],
      "languages": ["csharp", "visual-basic"],
      "analysisKinds": ["analyzer-catalog-metadata"],
      "license": {
        "name": "SONAR Source-Available License v1.0",
        "spdx": "LicenseRef-SSALv1",
        "classification": "source-available-restricted",
        "source": "https://github.com/SonarSource/sonar-dotnet/blob/master/LICENSE.txt"
      },
      "usage": {
        "automatedInspection": false,
        "aiIngestion": false,
        "copyImplementation": "blocked",
        "runtimeImport": false,
        "derivationMode": "metadata-only",
        "notes": "Current SSALv1 terms restrict competing use and AI interaction with the Program. Keep current source metadata-only unless a separately reviewed historical/permissive revision is registered."
      }
    }
  ]
}
