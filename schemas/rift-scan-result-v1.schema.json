{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalagab.github.io/omega/schemas/rift-scan-result-v1.schema.json",
  "title": "Canonical Rift workflow result envelope",
  "type": "object",
  "required": ["schema", "requestId", "variantId", "artifactSha256", "entryModel", "outcome", "runtimeReported", "processExitCode", "resultArtifact", "github", "files"],
  "properties": {
    "schema": {"const": "omega.rift.scan-result.v1"},
    "requestId": {"type": "string", "minLength": 1},
    "variantId": {"type": "integer", "minimum": 1},
    "artifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entryModel": {"enum": ["component", "location"]},
    "outcome": {"enum": ["completed", "runtime-failed", "no-runtime-report"]},
    "runtimeReported": {"type": "boolean"},
    "processExitCode": {"type": "integer"},
    "resultArtifact": {"const": "rift-runtime-results"},
    "github": {"type": "object"},
    "files": {"type": "object"}
  },
  "additionalProperties": true
}
