    "plugin": {
      "description": "Coordinates GatherBuddy Reborn and Artisan so timed gathering windows preempt crafting lists, with optional apartment-only crafting resume and conservative teleport-stall recovery.\nhttps://raw.githubusercontent.com/OrionCloudrunner/ArtisanBuddy/main/repo.json",
