    "plugin": {
      "description": "Adds a customisable radial wheel to Final Fantasy XIV. Assign emotes or macros to slots, organise them across multiple pages, bind a key to open the wheel, and execute them with a single click. Supports per-character and per-page colour theming.",
      "images": [],
