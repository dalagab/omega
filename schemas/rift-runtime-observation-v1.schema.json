{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalagab.github.io/omega/schemas/rift-runtime-observation-v1.schema.json",
  "title": "Interdimensional Rift runtime observation report",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "producer_version",
    "ran_at",
    "execution",
    "plugin",
    "observations",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "rift.runtime-observation.v1"
    },
    "producer": {
      "type": "string"
    },
    "producer_version": {
      "type": "string"
    },
    "ran_at": {
      "type": "string"
    },
    "execution": {
      "type": "object"
    },
    "plugin": {
      "type": "object",
      "required": [
        "path",
        "load_outcome"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "load_outcome": {
          "type": "string"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "ts_offset_ms"
        ]
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_observations",
        "by_kind"
      ]
    }
  },
  "additionalProperties": true
}
