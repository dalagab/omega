{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.invalid/schemas/omega-rift-alpha-execution-request-v1.schema.json",
  "title": "Rift Alpha local execution request v1",
  "type": "object",
  "required": ["schema", "lane", "synthetic", "authority", "runId", "alphaId", "scenarioSha256", "entryAssembly", "sdkContract"],
  "properties": {
    "schema": {"const": "omega.rift.alpha-execution-request.v1"},
    "lane": {"const": "alpha"},
    "synthetic": {"const": true},
    "authority": {"const": "local-alpha"},
    "runId": {"type": "string", "minLength": 1},
    "alphaId": {"type": "string", "pattern": "^alpha\\."},
    "scenarioSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entryAssembly": {"type": "string", "pattern": "\\.dll$"},
    "sdkContract": {"const": "Omega.Alpha.Sdk/IAlphaScenario/v1"}
  },
  "additionalProperties": false
}
