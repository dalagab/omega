{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalagab.github.io/omega/schemas/omega-player-environment-support-v1.schema.json",
  "title": "Omega player environment compatibility evidence",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "producer_version",
    "generated_at",
    "artifact_tree_sha256",
    "target_runtime",
    "player_environments"
  ],
  "properties": {
    "schema_version": {
      "const": "omega.player-environment-support.v1"
    },
    "producer": {
      "const": "rift-platform-evidence"
    },
    "producer_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "artifact_tree_sha256": {
      "type": "string"
    },
    "target_runtime": {
      "const": "windows-dalamud"
    },
    "important_note": {
      "type": "string"
    },
    "player_environments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_os",
          "execution_model",
          "status",
          "confidence",
          "evidence",
          "compatibility_factors",
          "blockers"
        ],
        "properties": {
          "id": {
            "enum": [
              "windows-native",
              "linux-wine-proton",
              "macos-crossover-wine"
            ]
          },
          "display_os": {
            "enum": [
              "windows",
              "linux",
              "macos"
            ]
          },
          "execution_model": {
            "type": "string"
          },
          "status": {
            "enum": [
              "target-runtime",
              "unverified",
              "compatibility-sensitive-unverified",
              "verified",
              "blocked"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "compatibility_factors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "managed_modules": {
      "type": "array"
    },
    "native_assets": {
      "type": "array"
    },
    "native_imports": {
      "type": "array"
    },
    "windows_dependencies": {
      "type": "array"
    },
    "platform_sensitive_assemblies": {
      "type": "array"
    },
    "analysis_runtime_verification": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
