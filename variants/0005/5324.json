    "plugin": {
      "description": "This Plugin does nothing on its own. Neko Fans needs to be installed.\nYou now have access to NSFW images in Neko Fans.\n\nPlugin from https://raw.githubusercontent.com/Meisterlala/NekoFans/master/repo.json",
      "images": [
        "https://raw.githubusercontent.com/resources/install_video.gif",
