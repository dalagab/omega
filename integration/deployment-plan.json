{
  "schema": "omega.alpha.deployment-plan.v1",
  "fixedBranches": {
    "corpus": "alpha",
    "results": "security-alpha-evidence"
  },
  "workflows": {
    "alphaSuite": {
      "count": 1,
      "owner": "rift"
    },
    "sigmascopeAdapter": {
      "count": 1,
      "owner": "sigmascope"
    },
    "alphaClientBuild": {
      "count": 1,
      "owner": "alpha",
      "trigger": "client/sdk/shared-boundary source changes",
      "release": "rift-alpha-client-edge"
    }
  },
  "deltascope": {
