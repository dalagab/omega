    },
    "projectRepository": "https://github.com/Meisterlala/NekoFans",
    "schema": "omega.evidence.presentation.v1",
    "website": {
      "description": "Neko Fans. The only FFXIV plugin you need!",
      "homepage": "",
      "images": [
        "https://raw.githubusercontent.com/resources/install_video.gif",
        "https://cdn.discordapp.com/emojis/851544845322551347.webp?size=44&quality=lossless",
        "https://cdn.discordapp.com/emojis/851511871625756694.webp?size=44&quality=lossless",
        "https://raw.githubusercontent.com/Meisterlala/NekoFans/master/icon18.png"
