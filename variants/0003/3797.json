    "schema": "omega.evidence.presentation.v1",
    "website": {
      "description": "A Dalamud plugin that automatically switches your gearset to match the queued job when you click Commence, bypassing the \"class/job is different\" error.",
      "homepage": "",
      "images": [
        "https://raw.githubusercontent.com/Valiice/JobAutoSwitcher/master/images/pop.png"
      ],
      "links": [
